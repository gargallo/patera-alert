        "@rollup/plugin-terser": "^0.4.4",
        "rollup": "^4.9.6",
        "rollup-plugin-cleanup": "^3.2.1",
        "rollup-plugin-serve": "^1.1.1",
        "rollup-plugin-svelte": "^7.1.6",
        "rollup-plugin-swc3": "^0.11.0",
        "svelte": "^4.2.9",
        "svelte-preprocess": "^5.1.3",
        "svelte-preprocess-less": "^0.4.0",
        "less": "^4.2.0",
        "typescript": "^5.3.3"
